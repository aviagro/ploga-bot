"""
בוט טלגרם לחיפוש בגוגל שיטס
==============================
הוראות הגדרה:
1. צור בוט דרך @BotFather בטלגרם וקבל TELEGRAM_TOKEN
2. פרסם את הגוגל שיטס שלך (File > Share > Anyone with the link can view)
3. עדכן את TELEGRAM_TOKEN ואת SHEET_CSV_URL בקובץ .env
4. הרץ: pip install python-telegram-bot requests pandas
5. הרץ: python bot.py
"""

import os
import logging
from dotenv import load_dotenv
load_dotenv()
import requests
import pandas as pd
from io import StringIO
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import (
    Application,
    CommandHandler,
    MessageHandler,
    CallbackQueryHandler,
    ContextTypes,
    filters,
)

# ─── הגדרות ────────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN = os.getenv("TELEGRAM_TOKEN", "YOUR_BOT_TOKEN_HERE")

# לינק CSV של הגוגל שיטס שלך
# איך לקבל: פתח את הגיליון > Share (ציבורי) > העתק את ה-ID מהURL
# ואז: https://docs.google.com/spreadsheets/d/SHEET_ID/export?format=csv
SHEET_CSV_URL = os.getenv(
    "SHEET_CSV_URL",
    "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv"
)

# עמודה ראשית לחיפוש (שם העמודה כפי שכתוב בגיליון שלך)
SEARCH_COLUMN = os.getenv("SEARCH_COLUMN", "")  # ריק = אוטומטי (עמודה ראשונה)

# ─── לוגים ─────────────────────────────────────────────────────────────────────
logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
)
logger = logging.getLogger(__name__)


# ─── פונקציות גוגל שיטס ────────────────────────────────────────────────────────

def fetch_sheet() -> pd.DataFrame | None:
    """טוען את הגיליון כ-DataFrame"""
    try:
        response = requests.get(SHEET_CSV_URL, timeout=10)
        response.raise_for_status()
        df = pd.read_csv(StringIO(response.text))
        df.columns = df.columns.str.strip()  # נקה רווחים מהכותרות
        return df
    except Exception as e:
        logger.error(f"שגיאה בטעינת הגיליון: {e}")
        return None


def search_in_sheet(query: str) -> list[dict]:
    """מחפש שורות שמכילות את ה-query בכל העמודות"""
    df = fetch_sheet()
    if df is None:
        return []

    query_lower = query.strip().lower()

    # חיפוש בעמודה הספציפית אם הוגדרה, אחרת בכל העמודות
    if SEARCH_COLUMN and SEARCH_COLUMN in df.columns:
        mask = df[SEARCH_COLUMN].astype(str).str.lower().str.contains(
            query_lower, na=False
        )
    else:
        mask = df.apply(
            lambda row: row.astype(str).str.lower().str.contains(query_lower, na=False).any(),
            axis=1,
        )

    results = df[mask].to_dict(orient="records")
    return results


def format_record(record: dict, index: int | None = None) -> str:
    """מעצב רשומה אחת להצגה בטלגרם"""
    lines = []
    if index is not None:
        lines.append(f"📋 *תוצאה {index}*")
    lines.append("─" * 20)
    for key, value in record.items():
        if pd.notna(value) and str(value).strip():
            lines.append(f"*{key}:* {value}")
    return "\n".join(lines)


def get_columns_info() -> str:
    """מחזיר מידע על מבנה הגיליון"""
    df = fetch_sheet()
    if df is None:
        return "❌ לא ניתן לטעון את הגיליון"
    cols = " | ".join(df.columns.tolist())
    return f"📊 *עמודות הגיליון:*\n`{cols}`\n\n📝 *סה\"כ שורות:* {len(df)}"


# ─── פקודות הבוט ───────────────────────────────────────────────────────────────

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """פקודת /start"""
    df = fetch_sheet()
    cols_info = ""
    if df is not None:
        cols_info = f"\n\n📊 עמודות זמינות: `{' | '.join(df.columns.tolist())}`"

    text = (
        "👋 *שלום! אני בוט חיפוש בגוגל שיטס*\n\n"
        "🔍 *איך לחפש:*\n"
        "פשוט שלח לי את מה שתרצה לחפש!\n\n"
        "📌 *פקודות:*\n"
        "/search `[מונח]` — חיפוש ספציפי\n"
        "/list — הצגת כל הרשומות\n"
        "/columns — מבנה הגיליון\n"
        "/help — עזרה"
        f"{cols_info}"
    )
    await update.message.reply_text(text, parse_mode="Markdown")


async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """פקודת /help"""
    text = (
        "📖 *עזרה*\n\n"
        "🔍 *חיפוש:*\n"
        "• שלח כל טקסט ואחפש בכל הגיליון\n"
        "• `/search ישראל` — חיפוש לפי שם\n"
        "• `/search 050` — חיפוש לפי טלפון\n\n"
        "📋 *צפייה:*\n"
        "• `/list` — כל הרשומות (עד 20)\n"
        "• `/columns` — מבנה הגיליון\n\n"
        "💡 *טיפ:* החיפוש אינו תלוי רישיות"
    )
    await update.message.reply_text(text, parse_mode="Markdown")


async def columns_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """פקודת /columns — הצגת מבנה הגיליון"""
    info = get_columns_info()
    await update.message.reply_text(info, parse_mode="Markdown")


async def search_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """פקודת /search [מונח]"""

    if not context.args:
        await update.message.reply_text(
            "❓ נא לציין מה לחפש:\n`/search [שם או מונח]`",
            parse_mode="Markdown",
        )
        return
    query = " ".join(context.args)
    await do_search(update, query)


async def list_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """פקודת /list — הצגת כל הרשומות"""
    df = fetch_sheet()
    if df is None:
        await update.message.reply_text("❌ שגיאה בטעינת הגיליון. נסה שוב.")
        return

    if df.empty:
        await update.message.reply_text("📭 הגיליון ריק.")
        return

    records = df.head(20).to_dict(orient="records")
    total = len(df)

    msg = f"📋 *רשימה ({min(20, total)} מתוך {total}):*\n\n"
    for i, rec in enumerate(records, 1):
        # הצג רק 2-3 ערכים ראשונים לתמצות
        preview_items = [(k, v) for k, v in rec.items() if pd.notna(v) and str(v).strip()][:3]
        preview = " | ".join(f"{k}: {v}" for k, v in preview_items)
        msg += f"`{i}.` {preview}\n"

    if total > 20:
        msg += f"\n_...ועוד {total - 20} רשומות. השתמש בחיפוש לתוצאה מדויקת_"

    await update.message.reply_text(msg, parse_mode="Markdown")


async def handle_text(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """מטפל בהודעות טקסט חופשי — מבצע חיפוש"""
    query = update.message.text.strip()
    if not query:
        return
    await do_search(update, query)


async def do_search(update: Update, query: str) -> None:
    """לוגיקת החיפוש המשותפת"""
    await update.message.reply_text(f"🔍 מחפש: *{query}*...", parse_mode="Markdown")

    results = search_in_sheet(query)

    if not results:
        await update.message.reply_text(
            f"😕 לא נמצאו תוצאות עבור: *{query}*\n\n"
            "💡 נסה מונח אחר או /list לצפייה בכל הרשימה",
            parse_mode="Markdown",
        )
        return

    if len(results) == 1:
        # תוצאה בודדת — הצג מיד
        text = format_record(results[0])
        await update.message.reply_text(text, parse_mode="Markdown")
    elif len(results) <= 5:
        # עד 5 תוצאות — הצג הכל
        header = f"✅ נמצאו *{len(results)}* תוצאות:\n\n"
        parts = [header] + [format_record(r, i) for i, r in enumerate(results, 1)]
        await update.message.reply_text("\n\n".join(parts), parse_mode="Markdown")
    else:
        # הרבה תוצאות — הצג סיכום עם כפתורים
        df = fetch_sheet()
        first_col = df.columns[0] if df is not None else "שם"

        # הצג 5 ראשונות
        header = f"✅ נמצאו *{len(results)}* תוצאות. מציג 5 ראשונות:\n\n"
        parts = [header] + [format_record(r, i) for i, r in enumerate(results[:5], 1)]

        if len(results) > 5:
            parts.append(f"\n_...ועוד {len(results) - 5}. נסה חיפוש מדויק יותר_")

        await update.message.reply_text("\n\n".join(parts), parse_mode="Markdown")


# ─── הפעלת הבוט ────────────────────────────────────────────────────────────────

def main() -> None:
    if TELEGRAM_TOKEN == "YOUR_BOT_TOKEN_HERE":
        print("❌ שגיאה: עדכן את TELEGRAM_TOKEN בקובץ .env")
        return
    if "YOUR_SHEET_ID" in SHEET_CSV_URL:
        print("❌ שגיאה: עדכן את SHEET_CSV_URL בקובץ .env")
        return

    app = Application.builder().token(TELEGRAM_TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("help", help_command))
    app.add_handler(CommandHandler("search", search_command))
    app.add_handler(CommandHandler("list", list_command))
    app.add_handler(CommandHandler("columns", columns_command))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))

    print("✅ הבוט פועל! לחץ Ctrl+C לעצירה.")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
