import os
import logging
from dotenv import load_dotenv
load_dotenv()
import requests
import pandas as pd
from io import StringIO
from telegram import Update
from telegram.ext import Application, CommandHandler, MessageHandler, ContextTypes, filters

TELEGRAM_TOKEN = os.getenv("TELEGRAM_TOKEN", "YOUR_BOT_TOKEN_HERE")
SHEET_CSV_URL = os.getenv("SHEET_CSV_URL", "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv")
SEARCH_COLUMN = os.getenv("SEARCH_COLUMN", "")

logging.basicConfig(format="%(asctime)s - %(name)s - %(levelname)s - %(message)s", level=logging.INFO)
logger = logging.getLogger(__name__)

def fetch_sheet():
    try:
        response = requests.get(SHEET_CSV_URL, timeout=10)
        response.raise_for_status()
        df = pd.read_csv(StringIO(response.text))
        df.columns = df.columns.str.strip()
        return df
    except Exception as e:
        logger.error(f"שגיאה: {e}")
        return None

def search_in_sheet(query):
    df = fetch_sheet()
    if df is None:
        return []
    query_lower = query.strip().lower()
    if SEARCH_COLUMN and SEARCH_COLUMN in df.columns:
        mask = df[SEARCH_COLUMN].astype(str).str.lower().str.contains(query_lower, na=False)
    else:
        mask = df.apply(lambda row: row.astype(str).str.lower().str.contains(query_lower, na=False).any(), axis=1)
    return df[mask].to_dict(orient="records")

def format_record(record, index=None):
    lines = []
    if index is not None:
        lines.append(f"תוצאה {index}")
    lines.append("-" * 20)
    for key, value in record.items():
        if pd.notna(value) and str(value).strip():
            lines.append(f"{key}: {value}")
    return "\n".join(lines)

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    df = fetch_sheet()
    cols_info = f"\nעמודות: {' | '.join(df.columns.tolist())}" if df is not None else ""
    await update.message.reply_text("שלום! שלח לי שם או מונח לחיפוש\n/list - כל הרשומות\n/columns - מבנה הגיליון" + cols_info)

async def columns_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    df = fetch_sheet()
    if df is None:
        await update.message.reply_text("שגיאה בטעינת הגיליון")
        return
    await update.message.reply_text(f"עמודות: {' | '.join(df.columns.tolist())}\nשורות: {len(df)}")

async def list_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    df = fetch_sheet()
    if df is None or df.empty:
        await update.message.reply_text("הגיליון ריק או לא נטען")
        return
    records = df.head(20).to_dict(orient="records")
    msg = f"רשימה ({min(20,len(df))} מתוך {len(df)}):\n\n"
    for i, rec in enumerate(records, 1):
        items = [(k,v) for k,v in rec.items() if pd.notna(v) and str(v).strip()][:3]
        msg += f"{i}. {' | '.join(f'{k}: {v}' for k,v in items)}\n"
    await update.message.reply_text(msg)

async def search_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.args:
        await update.message.reply_text("נא לציין מה לחפש: /search [שם]")
        return
    await do_search(update, " ".join(context.args))

async def handle_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await do_search(update, update.message.text.strip())

async def do_search(update: Update, query):
    await update.message.reply_text(f"מחפש: {query}...")
    results = search_in_sheet(query)
    if not results:
        await update.message.reply_text(f"לא נמצאו תוצאות עבור: {query}")
        return
    parts = [f"נמצאו {len(results)} תוצאות:\n"] + [format_record(r, i) for i, r in enumerate(results[:5], 1)]
    if len(results) > 5:
        parts.append(f"...ועוד {len(results)-5}")
    await update.message.reply_text("\n\n".join(parts))

def main():
    app = Application.builder().token(TELEGRAM_TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("search", search_command))
    app.add_handler(CommandHandler("list", list_command))
    app.add_handler(CommandHandler("columns", columns_command))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))
    print("הבוט פועל!")
    app.run_polling(allowed_updates=Update.ALL_TYPES)

if __name__ == "__main__":
    main()
